# Konfigurasi CctvViewer. Baris yang diawali # adalah komentar. Format: Kunci=Nilai
# Jalur relatif dihitung dari folder CctvViewer.exe.

# ---------- Layar ----------
# Jumlah monitor yang dipakai dan jumlah kamera per monitor (16 = grid 4x4).
# Layar 1 menampilkan kamera 1-16, layar 2 kamera 17-32, layar 3 kamera 33-48 (urut nama stream di go2rtc.yaml,
# atau urutan "order" di www\config.js).
Screens=3
CamsPerScreen=16
# auto = semua monitor yang terdeteksi Windows, diurut dari kiri ke kanan (lalu atas ke bawah).
# Manual (jika urutan salah): x,y,lebar,tinggi dipisah titik koma, contoh:
# Monitors=0,0,1920,1080;1920,0,1920,1080;3840,0,1920,1080
Monitors=auto
# Setelah PC menyala, monitor kadang terdeteksi terlambat. Tunggu sampai sekian detik hingga jumlahnya cukup.
MonitorWaitSeconds=60

# ---------- Browser ----------
# auto = Google Chrome, jika tidak ada maka Microsoft Edge. Atau isi jalur lengkap chrome.exe / msedge.exe.
Browser=auto
# Argumen tambahan untuk browser (opsional).
BrowserArgs=
# Jika layar ditutup (Alt+F4 atau browser crash), buka lagi otomatis. Keluar lewat tombol "Keluar" di header layar.
ReopenClosedScreens=true
# Muat ulang halaman tiap layar setiap sekian menit agar tetap segar 24 jam (0 = tidak). Tidak dilakukan saat ada kamera dibuka besar.
ReloadMinutes=360

# ---------- go2rtc ----------
Go2rtcExe=go2rtc.exe
Go2rtcConfig=go2rtc.yaml
# Harus sama dengan api.listen di go2rtc.yaml. Dipakai untuk menunggu go2rtc siap dan membuka halaman.
Go2rtcApi=http://127.0.0.1:1984

# ---------- NvrBridge (playback NX510, PTZ, peta) ----------
StartNvrBridge=true
NvrBridgeExe=NvrBridge\NvrBridge.exe
NvrBridgeConfig=NvrBridge\nvrbridge.config

# ---------- Lain-lain ----------
# Port kontrol lokal (tombol "Keluar" di halaman). Hanya 127.0.0.1.
ControlPort=1985
# Folder data (log dan profil browser). Kosong = folder "data" di samping CctvViewer.exe,
# jika tidak bisa ditulis maka %LOCALAPPDATA%\CctvViewer.
DataDir=
