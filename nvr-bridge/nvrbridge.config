# Konfigurasi NvrBridge. Baris yang diawali # adalah komentar. Format: Kunci=Nilai
# File ini berisi password NVR: batasi hak akses file (hanya akun yang menjalankan NvrBridge).

# ---------- NVR (NX510) ----------
NvrBaseUrl=https://192.168.1.50
# Buat user khusus di NVR dengan hak playback saja (jangan pakai admin).
NvrUser=playback
NvrPassword=GANTI-PASSWORD
# Digest sesuai dokumen CGI. Ubah ke Basic hanya jika NVR Anda terbukti memakainya.
NvrAuthScheme=Digest
# NX510 memakai HTTPS secara default dan biasanya bersertifikat self-signed.
# true = terima sertifikat NVR yang tidak tepercaya (hanya untuk host NVR di atas).
NvrAllowSelfSigned=true
# Zona waktu untuk STARTTIME/ENDTIME. Dokumen hanya menyebut UTC untuk perintah playback lain,
# jadi default-nya Utc. Jika klip yang diterima bergeser jam dari yang diminta, ganti ke Local.
NvrTimeMode=Utc

# ---------- Kamera (nomor kamera di NVR = nama yang tampil) ----------
# Pisahkan dengan titik koma. Nomor adalah "camera number" yang terdaftar di NVR.
Cameras=1=Kamera 1;2=Kamera 2;3=Kamera 3;4=Kamera 4

# ---------- Server web ----------
Title=Playback NVR
# localhost = hanya PC ini. Agar bisa dibuka dari PC lain: http://+:8090/ (lihat README: urlacl + firewall).
ListenPrefix=http://localhost:8090/
# Login (HTTP Basic) untuk halaman ini. Sangat disarankan jika ListenPrefix bisa dijangkau jaringan.
BridgeUser=
BridgePassword=

# ---------- Klip ----------
# MP4VO = tanpa audio (aman diputar di browser), MP4 = dengan audio (G.726 sering tidak bisa diputar browser).
ClipKind=MP4VO
# Durasi maksimal satu klip (menit). NVR membatasi 1 jam per permintaan.
MaxClipMinutes=10
ClipTimeoutMinutes=10
# Klip dihapus otomatis setelah sekian menit.
ClipRetentionMinutes=60
# Unduhan bersamaan (jaga beban NVR tetap rendah).
MaxConcurrentDownloads=2
ClipDir=clips

# true = tampilkan detail permintaan ke NVR di konsol (untuk diagnosis).
Verbose=false
