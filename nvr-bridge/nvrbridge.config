# Konfigurasi NvrBridge. Baris yang diawali # adalah komentar. Format: Kunci=Nilai
# File ini berisi password NVR: batasi hak akses file (hanya akun yang menjalankan NvrBridge).

# ---------- NVR (NX510) ----------
NvrBaseUrl=https://192.168.1.50
# Buat user khusus di NVR dengan hak playback saja (jangan pakai admin).
NvrUser=playback
NvrPassword=GANTI-PASSWORD
# Digest sesuai dokumen CGI. Ubah ke Basic hanya jika NVR Anda terbukti memakainya.
NvrAuthScheme=Digest
# NX510 memakai HTTPS secara default dan biasanya bersertifikat self-signed.
# true = terima sertifikat NVR yang tidak tepercaya (hanya untuk host NVR di atas).
NvrAllowSelfSigned=true
# Zona waktu untuk STARTTIME/ENDTIME. Dokumen hanya menyebut UTC untuk perintah playback lain,
# jadi default-nya Utc. Jika klip yang diterima bergeser jam dari yang diminta, ganti ke Local.
NvrTimeMode=Utc

# ---------- Kamera (nomor kamera di NVR = nama yang tampil) ----------
# Pisahkan dengan titik koma. Nomor adalah "camera number" yang terdaftar di NVR.
Cameras=1=Kamera 1;2=Kamera 2;3=Kamera 3;4=Kamera 4

# ---------- Server web ----------
Title=Playback NVR
# localhost = hanya PC ini. Agar bisa dibuka dari PC lain: http://+:8090/ (lihat README: urlacl + firewall).
ListenPrefix=http://localhost:8090/
# Login (HTTP Basic) untuk halaman ini. Sangat disarankan jika ListenPrefix bisa dijangkau jaringan.
BridgeUser=
BridgePassword=

# ---------- Halaman multiview (go2rtc) ----------
# Alamat halaman multiview, tanpa path. Wajib diisi agar halaman multiview (port 1984) boleh memanggil
# NvrBridge (port 8090) untuk PTZ dan peta. Contoh: AllowOrigin=http://192.168.1.10:1984
# Catatan: jika BridgeUser diisi, browser tidak meminta login untuk panggilan lintas-origin ini.
AllowOrigin=
# Folder penyimpanan peta denah.
DataDir=data

# ---------- PTZ kamera (opsional) ----------
# Nama stream di go2rtc = alamat kamera. Hanya kamera ini yang bisa dikontrol PTZ.
# Tanpa awalan = Dahua (ptz.cgi). Awalan "onvif:" = ONVIF (disarankan untuk i-PRO/Panasonic dan merek lain).
# Awalan "ipro:" = protokol aw_ptz (belum terverifikasi untuk kamera pengawas i-PRO; coba "onvif:" dulu).
# Contoh: PtzCameras=cam01=192.168.1.101;cam03=onvif:192.168.1.103;cam05=192.168.1.105:8080
PtzCameras=
# Buat user kamera khusus PTZ (bukan admin) jika kamera mendukung.
PtzUser=
PtzPassword=
# Nomor channel pada ptz.cgi (hanya kamera Dahua). Kamera IP tunggal Dahua biasanya 0.
PtzChannel=0
# Gerakan berhenti otomatis setelah sekian detik jika tombol stop tidak sampai.
PtzMaxMoveSeconds=8

# ---------- Klip ----------
# MP4VO = tanpa audio (aman diputar di browser), MP4 = dengan audio (G.726 sering tidak bisa diputar browser).
ClipKind=MP4VO
# Durasi maksimal satu klip (menit). NVR membatasi 1 jam per permintaan.
MaxClipMinutes=10
ClipTimeoutMinutes=10
# Klip dihapus otomatis setelah sekian menit.
ClipRetentionMinutes=60
# Unduhan bersamaan (jaga beban NVR tetap rendah).
MaxConcurrentDownloads=2
ClipDir=clips

# true = tampilkan detail permintaan ke NVR di konsol (untuk diagnosis).
Verbose=false

# ---------- Registrasi NVR (halaman setup.html) ----------
# NVR, daftar kamera, dan akun kamera bisa diisi lewat halaman <alamat NvrBridge>/setup.html (tombol "Kamera NVR" di multiview).
# Data disimpan di data\registry.json dan menimpa NvrBaseUrl/NvrUser/NvrPassword/Cameras di atas. Boleh dikosongkan di sini.
# go2rtc.yaml yang boleh ditulis oleh tombol "Terapkan ke go2rtc" (kosong = fitur itu mati). Hanya blok NVR-REGISTRY yang diubah.
Go2rtcYaml=
# Alamat API go2rtc, dipakai untuk memulai ulang go2rtc setelah go2rtc.yaml ditulis (go2rtc dijalankan ulang oleh CctvViewer).
Go2rtcApi=http://127.0.0.1:1984
